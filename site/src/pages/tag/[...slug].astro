---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedBlogPosts } from "../../lib/blog";
import { tagPages, tagTitle } from "../../lib/tags.mjs";

const baseUrl = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return tagPages(await getPublishedBlogPosts()).map(({ slug, ...props }) => ({
    params: { slug },
    props,
  }));
}

const { tag, posts, totalCount, page, totalPages, redirect } = Astro.props;
if (redirect) return Astro.redirect(`${baseUrl}tag/${redirect}/`, 301);
const label = tagTitle(tag);

const tagBase = `${baseUrl}tag/${tag}/`;
const prevHref = page > 1 ? (page === 2 ? tagBase : `${tagBase}${page - 1}/`) : null;
const nextHref = page < totalPages ? `${tagBase}${page + 1}/` : null;
---

<BaseLayout
  title={`Posts tagged "${label}"${page > 1 ? ` (Page ${page})` : ""} - Start Debugging`}
  description={`Tutorials, troubleshooting, and programming notes about ${label}.${page > 1 ? ` Page ${page}.` : ""}`}
  canonicalUrl={Astro.url.href}
  type="website"
>
  <section class="stack">
    <h1 class="h1">{label}</h1>
    <p class="muted">
      {totalCount} post{totalCount !== 1 ? "s" : ""}
      {totalPages > 1 ? <> &middot; Page {page} of {totalPages}</> : null}
    </p>
  </section>

  <section class="stack" style="margin-top: 18px;">
    {posts.map((post) => (
      <article class="panel card stack post-card">
        <div class="row">
          <span class="pill">{post.data.pubDate.toISOString().slice(0, 10)}</span>
          {post.data.tags?.slice(0, 3).map((t) => (
            <a class="pill" href={`${baseUrl}tag/${t}/`}>{t}</a>
          ))}
        </div>
        <a class="post-card-title-link stack" href={`${baseUrl}${post.slug}/`}>
          <h2 class="h2">{post.data.title}</h2>
          {post.data.description ? <div class="muted">{post.data.description}</div> : null}
        </a>
      </article>
    ))}

    {posts.length === 0 ? <div class="panel card muted">No posts found.</div> : null}
  </section>

  <div class="row" style="margin-top: 14px;">
    {prevHref ? <a class="pill" href={prevHref}>Prev</a> : null}
    {nextHref ? <a class="pill" href={nextHref}>Next</a> : null}
  </div>
</BaseLayout>
