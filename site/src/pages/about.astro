---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildLocaleUrlMap } from "../lib/blog";
import { t } from "../i18n";

const baseUrl = import.meta.env.BASE_URL;

const siteOrigin = Astro.site?.origin ?? "https://startdebugging.net";
const translations = buildLocaleUrlMap(siteOrigin, (l) =>
  l === "en" ? "/about/" : `/${l}/about/`,
);
---

<BaseLayout
  title={`${t("about.heading")} - Start Debugging`}
  description={t("about.description")}
  canonicalUrl={Astro.url.href}
  type="website"
  translations={translations}
>
  <article class="panel card stack prose">
    <div class="stack">
      <h1 class="h1">{t("about.heading")}</h1>
      <p class="muted">{t("about.tagline")}</p>
    </div>

    <section class="stack">
      <h2 id="editorial-process">{t("about.productionHeading")}</h2>
      <p set:html={t("about.body1")} />
      <p set:html={t("about.history")} />
    </section>

    <section class="stack">
      <h2 id="verification">{t("about.reviewHeading")}</h2>
      <p set:html={t("about.body2")} />
      <p set:html={t("about.reviewLimits")} />
    </section>

    <section class="stack">
      <h2 id="corrections">{t("about.correctionsHeading")}</h2>
      <p set:html={t("about.corrections")} />
      <p set:html={t("about.dates")} />
    </section>

    <section class="stack">
      <h2 id="contact">{t("about.contactHeading")}</h2>
      <p set:html={t("about.body3").replace("{rss}", `${baseUrl}rss.xml`)} />
    </section>
  </article>

  <div class="row" style="margin-top: 14px;">
    <a class="pill" href={baseUrl}>&lt; Back</a>
  </div>
</BaseLayout>
