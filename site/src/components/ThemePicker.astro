---
import { t } from '../i18n';
import type { Locale } from '../lib/blog';
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<label class="theme-picker pill">
  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
    <circle cx="10" cy="10" r="7" />
    <path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor" stroke="none" />
  </svg>
  <span class="sr-only">{t('theme.label', lang)}</span>
  <select data-theme-select autocomplete="off">
    <option value="system">{t('theme.system', lang)}</option>
    <option value="light">{t('theme.light', lang)}</option>
    <option value="dark">{t('theme.dark', lang)}</option>
  </select>
</label>
