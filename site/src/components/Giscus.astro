---
// Giscus comments widget. GitHub-Discussions-backed, lazy-loaded.
//
// Configuration is read from PUBLIC_GISCUS_* env vars at build time so we
// can flip comments on/off and rotate the backing repo without changing
// code. If any required value is missing, the component renders nothing —
// post pages stay clean until you've actually set up the backing repo.
//
// See `site/.env.example` for setup. The IDs come from giscus.app after
// you point it at your public comments repo (TRAFFIC_ROADMAP.md task 6.4).

import { langOf, type BlogPost, type Locale } from "../lib/blog";

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;

// Comments default-on for every post. The widget is lazy-loaded so an
// unread archive post pays zero cost; meanwhile older error-page posts
// still earn high-intent search traffic where commenting is most useful.
// Set `comments: false` in frontmatter to suppress on a specific post.
const enabledByPolicy = post.data.comments ?? true;

// Read config from env. PUBLIC_ prefix exposes these to client/static
// builds in Astro. Required: REPO, REPO_ID, CATEGORY, CATEGORY_ID. The
// rest have safe defaults.
const repo = import.meta.env.PUBLIC_GISCUS_REPO ?? "";
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID ?? "";
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY ?? "Blog comments";
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? "";
const theme = import.meta.env.PUBLIC_GISCUS_THEME ?? "dark";
const lightTheme = import.meta.env.PUBLIC_GISCUS_LIGHT_THEME ?? "light";

const configured = !!(repo && repoId && categoryId);
const showWidget = enabledByPolicy && configured;

// Map Astro locale to a giscus-supported language code. Giscus localizes
// the widget chrome (button labels, prompts) but not user-authored
// comments, so this is purely for the framing UI.
const lang = langOf(post) as Locale;
const giscusLang =
  lang === "pt-br" ? "pt"
  : lang === "ja" ? "ja"
  : lang === "ru" ? "ru"
  : lang === "de" ? "de"
  : lang === "es" ? "es"
  : "en";
---

{showWidget ? (
  <section
    class="comments-section"
    aria-labelledby="comments-heading"
    data-pagefind-ignore
  >
    <h2 id="comments-heading" class="h2">Comments</h2>
    <p class="muted">
      Sign in with GitHub to comment. Reactions and replies thread back to
      <a href={`https://github.com/${repo}/discussions`} rel="noopener">the comments repo</a>.
    </p>
    <div class="giscus" data-dark-theme={theme} data-light-theme={lightTheme} />
    <script is:inline define:vars={{ repo, repoId, category, categoryId, giscusLang }}>
      (() => {
        const container = document.querySelector('.giscus');
        if (!container) return;
        const currentTheme = () => document.documentElement.dataset.theme === 'light'
          ? container.dataset.lightTheme : container.dataset.darkTheme;
        const client = document.createElement('script');
        client.src = 'https://giscus.app/client.js';
        client.async = true;
        client.crossOrigin = 'anonymous';
        Object.assign(client.dataset, {
          repo, repoId, category, categoryId,
          mapping: 'pathname', strict: '0', reactionsEnabled: '1',
          emitMetadata: '0', inputPosition: 'bottom',
          theme: currentTheme(), lang: giscusLang, loading: 'lazy',
        });
        function syncTheme() {
          client.dataset.theme = currentTheme();
          container.querySelector('iframe.giscus-frame')?.contentWindow?.postMessage(
            { giscus: { setConfig: { theme: currentTheme() } } },
            'https://giscus.app',
          );
        }
        window.addEventListener('themechange', syncTheme);
        // The frame may load after a reader changes the theme.
        container.addEventListener('load', (event) => {
          if (event.target instanceof HTMLIFrameElement) syncTheme();
        }, true);
        container.appendChild(client);
      })();
    </script>
  </section>
) : null}
